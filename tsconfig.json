{
   "compilerOptions": {
      "target": "es2022",
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "esModuleInterop": true,
      "isolatedModules": true,
      "erasableSyntaxOnly": true,
      "verbatimModuleSyntax": true,
      "noImplicitAny": false,
      "skipLibCheck": true,
      "noEmit": true,
      "types": ["node"]
   },
   "include": ["src"],
   "exclude": ["node_modules", "tmp"]
}
